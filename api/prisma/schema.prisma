model AnchorOnboardingProgress {
  id                     String                      @id @default(uuid()) @db.Uuid
  anchorProfileId        String                      @unique @map("anchor_profile_id") @db.Uuid
  currentStage           OnboardingMilestoneType     @default(initial_communication) @map("current_stage")
  firstLiveAt            DateTime?                   @map("first_live_at")
  firstLiveBlockedReason String?                     @map("first_live_blocked_reason")
  firstReviewCompletedAt DateTime?                   @map("first_review_completed_at")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  anchorProfile          AnchorProfile               @relation(fields: [anchorProfileId], references: [id], onDelete: Cascade)
  milestones             AnchorOnboardingMilestone[]

  @@map("anchor_onboarding_progress")
}

model AnchorOnboardingMilestone {
  id                String                    @id @default(uuid()) @db.Uuid
  progressId        String                    @map("progress_id") @db.Uuid
  type              OnboardingMilestoneType
  status            OnboardingMilestoneStatus @default(pending)
  completedAt       DateTime?                 @map("completed_at")
  completedBy       String?                   @map("completed_by") @db.VarChar(64)
  note              String?
  evidence          Json?
  attachmentUrls    String[]                  @default([]) @map("attachment_urls")
  submittedAt       DateTime?                 @map("submitted_at")
  submittedBy       String?                   @map("submitted_by") @db.VarChar(64)
  anchorConfirmedAt DateTime?                 @map("anchor_confirmed_at")
  anchorRejectedAt  DateTime?                 @map("anchor_rejected_at")
  rejectReason      String?                   @map("reject_reason")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  progress          AnchorOnboardingProgress  @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([progressId, type])
  @@map("anchor_onboarding_milestones")
}

model ActivityType {
  id              String     @id @default(uuid()) @db.Uuid
  typeCode        String     @unique @map("type_code") @db.VarChar(50)
  typeName        String     @map("type_name") @db.VarChar(50)
  aggregationMode String     @map("aggregation_mode") @db.VarChar(30)
  entrySchema     Json       @map("entry_schema")
  metricUnit      String?    @map("metric_unit") @db.VarChar(30)
  createdAt       DateTime   @default(now()) @map("created_at")
  activities      Activity[]

  @@map("activity_types")
}

model Activity {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(100)
  typeId      String         @map("type_id") @db.Uuid
  startAt     DateTime       @map("start_at")
  endAt       DateTime       @map("end_at")
  status      ActivityStatus @default(draft)
  description String?
  coverUrl    String?        @map("cover_url")
  createdBy   String?        @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  type        ActivityType   @relation(fields: [typeId], references: [id])
  items       ActivityItem[]
  rules       RewardRule[]
  submissions Submission[]

  @@map("activities")
}

model ActivityItem {
  id              String           @id @default(uuid()) @db.Uuid
  activityId      String           @map("activity_id") @db.Uuid
  itemCode        String           @map("item_code") @db.VarChar(50)
  itemName        String           @map("item_name") @db.VarChar(100)
  itemType        String           @map("item_type") @db.VarChar(30)
  sortOrder       Int              @default(0) @map("sort_order")
  enabled         Boolean          @default(true)
  activity        Activity         @relation(fields: [activityId], references: [id])
  rules           RewardRule[]
  submissionItems SubmissionItem[]

  @@map("activity_items")
}

model RewardRule {
  id               String        @id @default(uuid()) @db.Uuid
  activityId       String        @map("activity_id") @db.Uuid
  itemId           String?       @map("item_id") @db.Uuid
  compareMode      String        @default("gte") @map("compare_mode") @db.VarChar(20)
  threshold        Decimal       @db.Decimal(18, 2)
  rewardType       String        @map("reward_type") @db.VarChar(20)
  rewardLabel      String        @map("reward_label") @db.VarChar(200)
  rewardValueCents Int           @default(0) @map("reward_value_cents")
  rewardPayload    Json?         @map("reward_payload")
  sortOrder        Int           @default(0) @map("sort_order")
  enabled          Boolean       @default(true)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  activity         Activity      @relation(fields: [activityId], references: [id])
  item             ActivityItem? @relation(fields: [itemId], references: [id])

  @@map("reward_rules")
}

model Submission {
  id                        String                     @id @default(uuid()) @db.Uuid
  activityId                String                     @map("activity_id") @db.Uuid
  anchorUserId              String                     @map("anchor_user_id") @db.Uuid
  anchorName                String                     @map("anchor_name") @db.VarChar(100)
  operatorId                String                     @map("operator_id") @db.Uuid
  anchorProfileId           String?                    @map("anchor_profile_id") @db.Uuid
  operatorAssignmentId      String?                    @map("operator_assignment_id") @db.Uuid
  anchorDisplayNameSnapshot String?                    @map("anchor_display_name_snapshot") @db.VarChar(100)
  operatorNameSnapshot      String?                    @map("operator_name_snapshot") @db.VarChar(100)
  operatorAssignmentStatus  SubmissionAssignmentStatus @default(confirmed) @map("operator_assignment_status")
  liveDate                  DateTime                   @map("live_date") @db.Date
  liveStartTime             DateTime                   @map("live_start_time") @db.Time(0)
  reviewStatus              ReviewStatus               @default(pending) @map("review_status")
  grantStatus               GrantStatus                @default(pending) @map("grant_status")
  rejectReason              String?                    @map("reject_reason")
  rewardSnapshot            Json?                      @map("reward_snapshot")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  activity                  Activity                   @relation(fields: [activityId], references: [id])
  anchorUser                WecomUser                  @relation(fields: [anchorUserId], references: [id])
  operator                  OperatorAccount            @relation(fields: [operatorId], references: [id])
  anchorProfile             AnchorProfile?             @relation(fields: [anchorProfileId], references: [id])
  operatorAssignment        AnchorOperatorAssignment?  @relation(fields: [operatorAssignmentId], references: [id])
  items                     SubmissionItem[]
  attachments               Attachment[]
  reviewLogs                ReviewLog[]
  rewardGrants              RewardGrant[]
  notifications             NotificationLog[]

  @@index([activityId, operatorId, liveDate], map: "idx_submissions_activity_operator_date")
  @@index([anchorUserId, activityId, liveDate], map: "idx_submissions_anchor_activity_date")
  @@index([anchorProfileId, operatorAssignmentStatus], map: "idx_submissions_anchor_assignment_status")
  @@map("submissions")
}

model SubmissionItem {
  id           String        @id @default(uuid()) @db.Uuid
  submissionId String        @map("submission_id") @db.Uuid
  itemId       String?       @map("item_id") @db.Uuid
  itemName     String        @map("item_name") @db.VarChar(100)
  quantity     Decimal       @db.Decimal(18, 2)
  extraPayload Json?         @map("extra_payload")
  submission   Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  item         ActivityItem? @relation(fields: [itemId], references: [id])

  @@map("submission_items")
}

model Attachment {
  id           String         @id @default(uuid()) @db.Uuid
  submissionId String?        @map("submission_id") @db.Uuid
  bucket       String         @db.VarChar(100)
  objectKey    String         @map("object_key") @db.VarChar(255)
  fileType     AttachmentType @map("file_type")
  fileUrl      String         @map("file_url")
  createdAt    DateTime       @default(now()) @map("created_at")
  submission   Submission?    @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model ReviewLog {
  id                String           @id @default(uuid()) @db.Uuid
  submissionId      String           @map("submission_id") @db.Uuid
  action            String           @db.VarChar(30)
  operatorAccountId String?          @map("operator_account_id") @db.Uuid
  note              String?
  createdAt         DateTime         @default(now()) @map("created_at")
  submission        Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  operatorAccount   OperatorAccount? @relation(fields: [operatorAccountId], references: [id])

  @@map("review_logs")
}

model RewardGrant {
  id                String           @id @default(uuid()) @db.Uuid
  submissionId      String           @map("submission_id") @db.Uuid
  status            GrantStatus
  grantedBy         String?          @map("granted_by") @db.Uuid
  grantedAt         DateTime?        @map("granted_at")
  remark            String?
  proofAttachmentId String?          @map("proof_attachment_id") @db.Uuid
  submission        Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  operatorAccount   OperatorAccount? @relation(fields: [grantedBy], references: [id])

  @@map("reward_grants")
}

model NotificationLog {
  id                  String             @id @default(uuid()) @db.Uuid
  submissionId        String?            @map("submission_id") @db.Uuid
  businessType        String?            @map("business_type") @db.VarChar(50)
  businessId          String?            @map("business_id") @db.VarChar(100)
  templateCode        String?            @map("template_code") @db.VarChar(80)
  dedupeKey           String?            @unique @map("dedupe_key") @db.VarChar(180)
  notificationType    String             @map("notification_type") @db.VarChar(50)
  receiverWecomUserId String             @map("receiver_wecom_user_id") @db.VarChar(64)
  receiverRole        String             @map("receiver_role") @db.VarChar(20)
  messageTitle        String             @map("message_title") @db.VarChar(200)
  messageContent      String             @map("message_content")
  status              NotificationStatus @default(pending)
  attemptCount        Int                @default(0) @map("attempt_count")
  maxAttempts         Int                @default(3) @map("max_attempts")
  errorMessage        String?            @map("error_message")
  scheduledAt         DateTime?          @map("scheduled_at")
  lastAttemptAt       DateTime?          @map("last_attempt_at")
  sentAt              DateTime?          @map("sent_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  submission          Submission?        @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, notificationType], map: "idx_notification_logs_submission_type")
  @@index([businessType, businessId], map: "idx_notification_logs_business")
  @@index([status, scheduledAt], map: "idx_notification_logs_retry")
  @@map("notification_logs")
}

model SystemJobRun {
  id             String             @id @default(uuid()) @db.Uuid
  jobCode        String             @map("job_code") @db.VarChar(100)
  idempotencyKey String             @map("idempotency_key") @db.VarChar(180)
  status         SystemJobRunStatus @default(running)
  triggeredBy    String?            @map("triggered_by") @db.VarChar(64)
  attemptCount   Int                @default(1) @map("attempt_count")
  scannedCount   Int                @default(0) @map("scanned_count")
  successCount   Int                @default(0) @map("success_count")
  failureCount   Int                @default(0) @map("failure_count")
  resultSummary  Json?              @map("result_summary")
  lastError      String?            @map("last_error")
  startedAt      DateTime           @default(now()) @map("started_at")
  finishedAt     DateTime?          @map("finished_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@unique([jobCode, idempotencyKey])
  @@index([status, startedAt])
  @@map("system_job_runs")
}

model IntegrationIncident {
  id             String                      @id @default(uuid()) @db.Uuid
  provider       String                      @db.VarChar(50)
  operation      String                      @db.VarChar(100)
  businessType   String?                     @map("business_type") @db.VarChar(50)
  businessId     String?                     @map("business_id") @db.VarChar(100)
  dedupeKey      String                      @unique @map("dedupe_key") @db.VarChar(180)
  status         IntegrationIncidentStatus   @default(open)
  severity       IntegrationIncidentSeverity @default(error)
  occurrenceCount Int                        @default(1) @map("occurrence_count")
  errorCode      String?                     @map("error_code") @db.VarChar(80)
  errorMessage   String                      @map("error_message")
  firstOccurredAt DateTime                   @default(now()) @map("first_occurred_at")
  lastOccurredAt DateTime                    @default(now()) @map("last_occurred_at")
  resolvedAt     DateTime?                   @map("resolved_at")
  resolvedBy     String?                     @map("resolved_by") @db.VarChar(64)
  resolutionNote String?                     @map("resolution_note")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")

  @@index([status, severity, lastOccurredAt])
  @@index([provider, operation, lastOccurredAt])
  @@map("integration_incidents")
}

model SystemAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.VarChar(64)
  actorRole     String   @map("actor_role") @db.VarChar(40)
  loginType     String   @map("login_type") @db.VarChar(40)
  action        String   @db.VarChar(100)
  objectType    String   @map("object_type") @db.VarChar(80)
  objectId      String?  @map("object_id") @db.VarChar(100)
  beforeSnapshot Json?   @map("before_snapshot")
  afterSnapshot Json?    @map("after_snapshot")
  reason        String?
  requestTraceId String? @map("request_trace_id") @db.VarChar(100)
