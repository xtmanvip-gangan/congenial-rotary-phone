generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  operator
  super_admin
}

enum StaffRole {
  audit_teacher
  operator
  training_teacher
  training_admin
}

enum ActivationTaskStatus {
  pending
  invited
  activated
  cancelled
}

enum AnchorProfileStatus {
  active
  paused
  leave
  exited
}

enum OperatorAssignmentStatus {
  pending_confirmation
  confirmed
  rejected
  ended
}

enum OnboardingMilestoneType {
  operator_received
  initial_communication
  homepage_ready
  live_software_ready
  helper_software_ready
  prejob_learning_completed
  prelive_check_completed
  first_live_completed
  first_live_review_completed
}

enum OnboardingMilestoneStatus {
  pending
  awaiting_anchor_confirm
  completed
}

enum SubmissionAssignmentStatus {
  pending_confirmation
  confirmed
}

enum TrainingCourseLevel {
  basic_required
  growth
  advanced
  special
}

enum TrainingWeekParity {
  every
  a
  b
}

enum TrainingSessionStatus {
  draft
  published
  in_progress
  ended
  cancelled
  rescheduled
  publish_failed
}

enum TrainingRegistrationStatus {
  registered
  waitlisted
  cancelled
  learned
  leave
  absent
  abnormal_exit
  needs_makeup
}

enum TrainingRegistrationSource {
  anchor
  operator
  training_staff
}

enum TrainingLearningType {
  first_learning
  review
  makeup
}

enum TrainingProgressStatus {
  not_started
  registered
  learned
}

enum TrainingMakeupStatus {
  none
  needs_relearning
  waiting_makeup
  made_up
}

enum TrainingMeetingCreateStatus {
  pending
  created
  failed
  cancelled
}

enum TrainingAttendanceSource {
  api
  excel
}

enum TrainingAttendanceImportStatus {
  preview
  confirmed
  failed
}

enum TrainingAttendanceMatchStatus {
  matched
  conflict
  unmatched
}

enum TrainingAttendanceOutcome {
  pending_confirmation
  learned
  needs_makeup
}

enum TrainingRecommendationSource {
  system
  operator
  training_staff
}

enum TrainingApplicationStatus {
  unobserved
  practicing
  applied
  needs_support
}

enum TrainingQuestionUrgency {
  normal
  urgent
}

enum TrainingQuestionStatus {
  pending
  categorized
  scheduled
  resolved
  transferred
}

enum TrainingQuestionResolutionType {
  standard_course
  review_session
  saturday_qa
  special_course
  new_course_need
  operator_followup
}

enum TrainingWeeklyActionStatus {
  pending
  completed
  cancelled
}

enum ActivityStatus {
  draft
  active
  ended
  disabled
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum GrantStatus {
  pending
  granted
}

enum AttachmentType {
  submission_proof
  grant_proof
}

enum NotificationStatus {
  pending
  success
  failed
}

enum SystemJobRunStatus {
  running
  succeeded
  partial
  failed
}

enum IntegrationIncidentStatus {
  open
  recovered
  closed
}

enum IntegrationIncidentSeverity {
  warning
  error
  critical
}

model WecomUser {
  id            String         @id @default(uuid()) @db.Uuid
  wecomUserId   String         @unique @map("wecom_user_id") @db.VarChar(64)
  wecomName     String?        @map("wecom_name") @db.VarChar(100)
  avatarUrl     String?        @map("avatar_url")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  submissions   Submission[]
  anchorProfile AnchorProfile?

  @@map("wecom_users")
}

model OperatorAccount {
  id                          String                         @id @default(uuid()) @db.Uuid
  wecomUserId                 String?                        @unique @map("wecom_user_id") @db.VarChar(64)
  username                    String?                        @unique @db.VarChar(64)
  passwordHash                String?                        @map("password_hash")
  role                        AccountRole
  displayName                 String                         @map("display_name") @db.VarChar(100)
  status                      String                         @default("active") @db.VarChar(20)
  createdAt                   DateTime                       @default(now()) @map("created_at")
  updatedAt                   DateTime                       @updatedAt @map("updated_at")
  submissions                 Submission[]
  reviewLogs                  ReviewLog[]
  rewardGrants                RewardGrant[]
  staffRoles                  StaffRoleAssignment[]
  activationTasks             AnchorActivationTask[]         @relation("ActivationAuditTeacher")
  assignedActivationTasks     AnchorActivationTask[]         @relation("ActivationAssignedOperator")
  currentAnchors              AnchorProfile[]                @relation("CurrentAnchorOperator")
  anchorAssignments           AnchorOperatorAssignment[]     @relation("AssignmentOperator")
  trainingSessions            TrainingSession[]              @relation("TrainingSessionTeacher")
  scheduleTemplates           TrainingScheduleTemplate[]     @relation("TrainingTemplateTeacher")
  trainingRecommendations     TrainingCourseRecommendation[] @relation("TrainingRecommendationCreator")
  trainingApplicationFeedback TrainingApplicationFeedback[]  @relation("TrainingFeedbackOperator")
  trainingQuestions           TrainingQuestion[]             @relation("TrainingQuestionSubmitter")
  trainingQuestionActions     TrainingQuestionAction[]       @relation("TrainingQuestionActor")
  trainingWeeklyMeetings      TrainingWeeklyMeeting[]        @relation("TrainingWeeklyMeetingCreator")
  trainingWeeklyActions       TrainingWeeklyAction[]         @relation("TrainingWeeklyActionOwner")

  @@map("operator_accounts")
}

model StaffRoleAssignment {
  id        String          @id @default(uuid()) @db.Uuid
  accountId String          @map("account_id") @db.Uuid
  role      StaffRole
  createdBy String?         @map("created_by") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")
  account   OperatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, role])
  @@map("staff_role_assignments")
}

model AnchorActivationTask {
  id                       String               @id @default(uuid()) @db.Uuid
  expectedWecomUserId      String               @unique @map("expected_wecom_user_id") @db.VarChar(64)
  wecomDisplayNameSnapshot String               @map("wecom_display_name_snapshot") @db.VarChar(100)
  auditTeacherId           String               @map("audit_teacher_id") @db.Uuid
  operatorId               String?              @map("operator_id") @db.Uuid
  membershipCompletedAt    DateTime             @map("membership_completed_at")
  status                   ActivationTaskStatus @default(pending)
  invitationSentAt         DateTime?            @map("invitation_sent_at")
  invitationCount          Int                  @default(0) @map("invitation_count")
  activatedAnchorProfileId String?              @unique @map("activated_anchor_profile_id") @db.Uuid
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  auditTeacher             OperatorAccount      @relation("ActivationAuditTeacher", fields: [auditTeacherId], references: [id])
  operator                 OperatorAccount?     @relation("ActivationAssignedOperator", fields: [operatorId], references: [id])
  activatedAnchorProfile   AnchorProfile?       @relation(fields: [activatedAnchorProfileId], references: [id])

  @@index([operatorId])
  @@index([status, createdAt])
  @@map("anchor_activation_tasks")
}

model AnchorProfile {
  id                          String                         @id @default(uuid()) @db.Uuid
  wecomUserRecordId           String                         @unique @map("wecom_user_record_id") @db.Uuid
  anchorDisplayName           String                         @map("anchor_display_name") @db.VarChar(100)
  currentOperatorId           String?                        @map("current_operator_id") @db.Uuid
  assignmentStatus            OperatorAssignmentStatus?      @map("assignment_status")
  source                      String                         @default("activation") @db.VarChar(30)
  status                      AnchorProfileStatus            @default(active)
  activatedAt                 DateTime                       @default(now()) @map("activated_at")
  createdAt                   DateTime                       @default(now()) @map("created_at")
  updatedAt                   DateTime                       @updatedAt @map("updated_at")
  wecomUser                   WecomUser                      @relation(fields: [wecomUserRecordId], references: [id])
  currentOperator             OperatorAccount?               @relation("CurrentAnchorOperator", fields: [currentOperatorId], references: [id])
  assignments                 AnchorOperatorAssignment[]
  activationTask              AnchorActivationTask?
  nameHistory                 AnchorNameHistory[]
  onboardingProgress          AnchorOnboardingProgress?
  submissions                 Submission[]
  trainingRegistrations       TrainingRegistration[]
  trainingProgress            TrainingLearningProgress[]
  trainingAttendance          TrainingAttendanceRecord[]
  trainingRecommendations     TrainingCourseRecommendation[]
  trainingApplicationFeedback TrainingApplicationFeedback[]
  trainingQuestions           TrainingQuestion[]

  @@index([currentOperatorId, assignmentStatus])
  @@map("anchor_profiles")
}

model TrainingCourse {
  id                  String                         @id @default(uuid()) @db.Uuid
  code                String                         @unique @db.VarChar(30)
  title               String                         @db.VarChar(120)
  level               TrainingCourseLevel
  sequence            Int?
  summary             String?
  objectives          Json                           @default("[]")
  practiceTasks       Json                           @default("[]") @map("practice_tasks")
  faq                 Json                           @default("[]")
  status              String                         @default("active") @db.VarChar(20)
  createdBy           String?                        @map("created_by") @db.Uuid
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")
  materialLinks       TrainingMaterialLink[]
  templates           TrainingScheduleTemplate[]
  sessions            TrainingSession[]
  learningProgress    TrainingLearningProgress[]
  recommendations     TrainingCourseRecommendation[] @relation("TrainingRecommendedCourse")
  nextCourseFeedback  TrainingApplicationFeedback[]  @relation("TrainingFeedbackNextCourse")
  applicationFeedback TrainingApplicationFeedback[]  @relation("TrainingFeedbackCourse")
  questions           TrainingQuestion[]

  @@index([status, sequence])
  @@map("training_courses")
}

model TrainingMaterialLink {
  id        String         @id @default(uuid()) @db.Uuid
  courseId  String         @map("course_id") @db.Uuid
  title     String         @db.VarChar(120)
  url       String
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  course    TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, sortOrder])
  @@map("training_material_links")
}

model TrainingScheduleTemplate {
  id              String             @id @default(uuid()) @db.Uuid
  courseId        String             @map("course_id") @db.Uuid
  teacherId       String?            @map("teacher_id") @db.Uuid
  weekday         Int
  weekParity      TrainingWeekParity @default(every) @map("week_parity")
  startTime       String             @map("start_time") @db.VarChar(5)
  durationMinutes Int                @default(60) @map("duration_minutes")
  capacity        Int                @default(50)
  active          Boolean            @default(true)
  createdBy       String?            @map("created_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  course          TrainingCourse     @relation(fields: [courseId], references: [id])
  teacher         OperatorAccount?   @relation("TrainingTemplateTeacher", fields: [teacherId], references: [id])
  sessions        TrainingSession[]

  @@index([active, weekday])
  @@map("training_schedule_templates")
}

model TrainingSession {
  id                 String                     @id @default(uuid()) @db.Uuid
  courseId           String                     @map("course_id") @db.Uuid
  scheduleTemplateId String?                    @map("schedule_template_id") @db.Uuid
  teacherId          String?                    @map("teacher_id") @db.Uuid
  scheduledStartAt   DateTime                   @map("scheduled_start_at")
  scheduledEndAt     DateTime                   @map("scheduled_end_at")
  capacity           Int                        @default(50)
  status             TrainingSessionStatus      @default(draft)
  publishedAt        DateTime?                  @map("published_at")
  cancellationReason String?                    @map("cancellation_reason")
  createdBy          String?                    @map("created_by") @db.Uuid
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  course             TrainingCourse             @relation(fields: [courseId], references: [id])
  scheduleTemplate   TrainingScheduleTemplate?  @relation(fields: [scheduleTemplateId], references: [id])
  teacher            OperatorAccount?           @relation("TrainingSessionTeacher", fields: [teacherId], references: [id])
  registrations      TrainingRegistration[]
  meeting            TrainingMeeting?
  attendanceImports  TrainingAttendanceImport[]
  attendanceRecords  TrainingAttendanceRecord[]

  @@unique([scheduleTemplateId, scheduledStartAt])
  @@index([status, scheduledStartAt])
  @@index([courseId, scheduledStartAt])
  @@map("training_sessions")
}

model TrainingRegistration {
  id                   String                     @id @default(uuid()) @db.Uuid
  anchorProfileId      String                     @map("anchor_profile_id") @db.Uuid
  sessionId            String                     @map("session_id") @db.Uuid
  operatorIdSnapshot   String?                    @map("operator_id_snapshot") @db.Uuid
  operatorNameSnapshot String?                    @map("operator_name_snapshot") @db.VarChar(100)
  anchorNameSnapshot   String                     @map("anchor_name_snapshot") @db.VarChar(100)
  source               TrainingRegistrationSource
  status               TrainingRegistrationStatus
  learningType         TrainingLearningType       @map("learning_type")
  waitlistPosition     Int?                       @map("waitlist_position")
  registeredBy         String                     @map("registered_by") @db.VarChar(64)
  registeredAt         DateTime                   @default(now()) @map("registered_at")
  cancelledAt          DateTime?                  @map("cancelled_at")
  outcomeReason        String?                    @map("outcome_reason")
  outcomeBy            String?                    @map("outcome_by") @db.VarChar(64)
  outcomeAt            DateTime?                  @map("outcome_at")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")
  anchorProfile        AnchorProfile              @relation(fields: [anchorProfileId], references: [id])
  session              TrainingSession            @relation(fields: [sessionId], references: [id])
  attendanceRecords    TrainingAttendanceRecord[]

  @@unique([anchorProfileId, sessionId])
  @@index([sessionId, status, waitlistPosition])
  @@index([anchorProfileId, status])
  @@map("training_registrations")
}

model TrainingLearningProgress {
  id              String                 @id @default(uuid()) @db.Uuid
  anchorProfileId String                 @map("anchor_profile_id") @db.Uuid
  courseId        String                 @map("course_id") @db.Uuid
  status          TrainingProgressStatus @default(not_started)
  makeupStatus    TrainingMakeupStatus   @default(none) @map("makeup_status")
  firstLearnedAt  DateTime?              @map("first_learned_at")
  lastLearnedAt   DateTime?              @map("last_learned_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  anchorProfile   AnchorProfile          @relation(fields: [anchorProfileId], references: [id], onDelete: Cascade)
  course          TrainingCourse         @relation(fields: [courseId], references: [id])

  @@unique([anchorProfileId, courseId])
  @@index([anchorProfileId, status])
  @@map("training_learning_progress")
}

model TrainingMeeting {
  id                String                      @id @default(uuid()) @db.Uuid
  sessionId         String                      @unique @map("session_id") @db.Uuid
  externalMeetingId String?                     @unique @map("external_meeting_id") @db.VarChar(64)
  meetingCode       String?                     @map("meeting_code") @db.VarChar(32)
  joinUrl           String?                     @map("join_url")
  createStatus      TrainingMeetingCreateStatus @default(pending) @map("create_status")
  responseSummary   Json?                       @map("response_summary")
  createAttempts    Int                         @default(0) @map("create_attempts")
  lastError         String?                     @map("last_error")
  lastSyncAt        DateTime?                   @map("last_sync_at")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  session           TrainingSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([createStatus, updatedAt])
  @@map("training_meetings")
}

model TrainingAttendanceImport {
  id                String                         @id @default(uuid()) @db.Uuid
  sessionId         String                         @map("session_id") @db.Uuid
  source            TrainingAttendanceSource
  status            TrainingAttendanceImportStatus @default(preview)
  idempotencyKey    String                         @map("idempotency_key") @db.VarChar(128)
  fileName          String?                        @map("file_name") @db.VarChar(255)
  sourceSummary     Json?                          @map("source_summary")
  previewSummary    Json?                          @map("preview_summary")
  importedBy        String                         @map("imported_by") @db.VarChar(64)
  confirmedBy       String?                        @map("confirmed_by") @db.VarChar(64)
  confirmedAt       DateTime?                      @map("confirmed_at")
  errorMessage      String?                        @map("error_message")
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @updatedAt @map("updated_at")
  session           TrainingSession                @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rawRecords        TrainingAttendanceRawRecord[]
  attendanceRecords TrainingAttendanceRecord[]

  @@unique([sessionId, source, idempotencyKey])
  @@index([sessionId, createdAt])
  @@map("training_attendance_imports")
}

model TrainingAttendanceRawRecord {
  id                  String                   @id @default(uuid()) @db.Uuid
  importId            String                   @map("import_id") @db.Uuid
  externalRecordKey   String                   @map("external_record_key") @db.VarChar(160)
  externalUserId      String?                  @map("external_user_id") @db.VarChar(128)
  externalIdentityKey String                   @map("external_identity_key") @db.VarChar(160)
  rawDisplayName      String                   @map("raw_display_name") @db.VarChar(255)
  displayName         String                   @map("display_name") @db.VarChar(100)
  joinedAt            DateTime?                @map("joined_at")
  leftAt              DateTime?                @map("left_at")
  durationSeconds     Int                      @default(0) @map("duration_seconds")
  rawPayload          Json                     @map("raw_payload")
  createdAt           DateTime                 @default(now()) @map("created_at")
  import              TrainingAttendanceImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, externalRecordKey])
  @@index([importId, externalIdentityKey])
  @@map("training_attendance_raw_records")
}

model TrainingAttendanceRecord {
  id                     String                        @id @default(uuid()) @db.Uuid
  sessionId              String                        @map("session_id") @db.Uuid
  importId               String                        @map("import_id") @db.Uuid
  registrationId         String?                       @map("registration_id") @db.Uuid
  anchorProfileId        String?                       @map("anchor_profile_id") @db.Uuid
  externalIdentityKey    String                        @map("external_identity_key") @db.VarChar(160)
  externalUserId         String?                       @map("external_user_id") @db.VarChar(128)
  displayName            String                        @map("display_name") @db.VarChar(100)
  intervals              Json                          @default("[]")
  totalDurationSeconds   Int                           @default(0) @map("total_duration_seconds")
  sessionDurationSeconds Int                           @map("session_duration_seconds")
  attendanceRatio        Decimal                       @default(0) @map("attendance_ratio") @db.Decimal(6, 4)
  matchStatus            TrainingAttendanceMatchStatus @map("match_status")
  matchMethod            String?                       @map("match_method") @db.VarChar(40)
  outcome                TrainingAttendanceOutcome     @default(pending_confirmation)
  matchedBy              String?                       @map("matched_by") @db.VarChar(64)
  matchedAt              DateTime?                     @map("matched_at")
  outcomeBy              String?                       @map("outcome_by") @db.VarChar(64)
  outcomeAt              DateTime?                     @map("outcome_at")
  manualReason           String?                       @map("manual_reason")
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")
  session                TrainingSession               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  import                 TrainingAttendanceImport      @relation(fields: [importId], references: [id])
  registration           TrainingRegistration?         @relation(fields: [registrationId], references: [id])
  anchorProfile          AnchorProfile?                @relation(fields: [anchorProfileId], references: [id])
  auditLogs              TrainingAttendanceAuditLog[]

  @@unique([sessionId, externalIdentityKey])
  @@index([registrationId])
  @@index([sessionId, matchStatus, outcome])
  @@map("training_attendance_records")
}

model TrainingAttendanceAuditLog {
  id                 String                   @id @default(uuid()) @db.Uuid
  attendanceRecordId String                   @map("attendance_record_id") @db.Uuid
  action             String                   @db.VarChar(40)
  beforeSnapshot     Json?                    @map("before_snapshot")
  afterSnapshot      Json?                    @map("after_snapshot")
  reason             String?
  operatedBy         String                   @map("operated_by") @db.VarChar(64)
  createdAt          DateTime                 @default(now()) @map("created_at")
  attendanceRecord   TrainingAttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([attendanceRecordId, createdAt])
  @@map("training_attendance_audit_logs")
}

model TrainingCourseRecommendation {
  id                     String                       @id @default(uuid()) @db.Uuid
  anchorProfileId        String                       @map("anchor_profile_id") @db.Uuid
  courseId               String                       @map("course_id") @db.Uuid
  source                 TrainingRecommendationSource
  recommendedByAccountId String?                      @map("recommended_by_account_id") @db.Uuid
  reason                 String?
  viewedAt               DateTime?                    @map("viewed_at")
  registeredAt           DateTime?                    @map("registered_at")
  completedAt            DateTime?                    @map("completed_at")
  createdAt              DateTime                     @default(now()) @map("created_at")
  updatedAt              DateTime                     @updatedAt @map("updated_at")
  anchorProfile          AnchorProfile                @relation(fields: [anchorProfileId], references: [id], onDelete: Cascade)
  course                 TrainingCourse               @relation("TrainingRecommendedCourse", fields: [courseId], references: [id])
  recommendedByAccount   OperatorAccount?             @relation("TrainingRecommendationCreator", fields: [recommendedByAccountId], references: [id])

  @@unique([anchorProfileId, courseId, source])
  @@index([anchorProfileId, completedAt, createdAt])
  @@map("training_course_recommendations")
}

model TrainingApplicationFeedback {
  id                 String                    @id @default(uuid()) @db.Uuid
  anchorProfileId    String                    @map("anchor_profile_id") @db.Uuid
  courseId           String                    @map("course_id") @db.Uuid
  operatorId         String                    @map("operator_id") @db.Uuid
  weekStart          DateTime                  @map("week_start") @db.Date
  status             TrainingApplicationStatus @default(unobserved)
  observationNote    String?                   @map("observation_note")
  replayIssue        String?                   @map("replay_issue")
  nextCourseId       String?                   @map("next_course_id") @db.Uuid
  interventionNeeded Boolean                   @default(false) @map("intervention_needed")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  anchorProfile      AnchorProfile             @relation(fields: [anchorProfileId], references: [id], onDelete: Cascade)
  course             TrainingCourse            @relation("TrainingFeedbackCourse", fields: [courseId], references: [id])
  operator           OperatorAccount           @relation("TrainingFeedbackOperator", fields: [operatorId], references: [id])
  nextCourse         TrainingCourse?           @relation("TrainingFeedbackNextCourse", fields: [nextCourseId], references: [id])

  @@unique([anchorProfileId, courseId, weekStart])
  @@index([operatorId, weekStart, status])
  @@map("training_application_feedback")
}

model TrainingQuestion {
  id                   String                          @id @default(uuid()) @db.Uuid
  anchorProfileId      String?                         @map("anchor_profile_id") @db.Uuid
  courseId             String?                         @map("course_id") @db.Uuid
  submittedByAccountId String                          @map("submitted_by_account_id") @db.Uuid
  category             String?                         @db.VarChar(80)
  urgency              TrainingQuestionUrgency         @default(normal)
  description          String
  caseNote             String?                         @map("case_note")
  status               TrainingQuestionStatus          @default(pending)
  resolutionType       TrainingQuestionResolutionType? @map("resolution_type")
  resolvedAt           DateTime?                       @map("resolved_at")
  createdAt            DateTime                        @default(now()) @map("created_at")
  updatedAt            DateTime                        @updatedAt @map("updated_at")
  anchorProfile        AnchorProfile?                  @relation(fields: [anchorProfileId], references: [id])
  course               TrainingCourse?                 @relation(fields: [courseId], references: [id])
  submittedByAccount   OperatorAccount                 @relation("TrainingQuestionSubmitter", fields: [submittedByAccountId], references: [id])
  actions              TrainingQuestionAction[]

  @@index([urgency, status, createdAt])
  @@index([anchorProfileId, createdAt])
  @@map("training_questions")
}

model TrainingQuestionAction {
  id           String           @id @default(uuid()) @db.Uuid
  questionId   String           @map("question_id") @db.Uuid
  action       String           @db.VarChar(50)
  note         String?
  operatedById String           @map("operated_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  question     TrainingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  operatedBy   OperatorAccount  @relation("TrainingQuestionActor", fields: [operatedById], references: [id])

  @@index([questionId, createdAt])
  @@map("training_question_actions")
}

model TrainingWeeklyMeeting {
  id          String                 @id @default(uuid()) @db.Uuid
  weekStart   DateTime               @map("week_start") @db.Date
  heldAt      DateTime?              @map("held_at")
  attendeeIds Json                   @default("[]") @map("attendee_ids")
  summary     String?
  createdById String                 @map("created_by_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  createdBy   OperatorAccount        @relation("TrainingWeeklyMeetingCreator", fields: [createdById], references: [id])
  actions     TrainingWeeklyAction[]

  @@unique([weekStart])
  @@map("training_weekly_meetings")
}

model TrainingWeeklyAction {
  id             String                     @id @default(uuid()) @db.Uuid
  meetingId      String                     @map("meeting_id") @db.Uuid
  title          String                     @db.VarChar(200)
  ownerAccountId String?                    @map("owner_account_id") @db.Uuid
  dueAt          DateTime?                  @map("due_at")
  status         TrainingWeeklyActionStatus @default(pending)
  completedAt    DateTime?                  @map("completed_at")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  meeting        TrainingWeeklyMeeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  ownerAccount   OperatorAccount?           @relation("TrainingWeeklyActionOwner", fields: [ownerAccountId], references: [id])

  @@index([ownerAccountId, status, dueAt])
  @@map("training_weekly_actions")
}

model AnchorNameHistory {
  id              String        @id @default(uuid()) @db.Uuid
  anchorProfileId String        @map("anchor_profile_id") @db.Uuid
  oldName         String        @map("old_name") @db.VarChar(100)
  newName         String        @map("new_name") @db.VarChar(100)
  changedByType   String        @map("changed_by_type") @db.VarChar(30)
  changedById     String?       @map("changed_by_id") @db.VarChar(64)
  createdAt       DateTime      @default(now()) @map("created_at")
  anchorProfile   AnchorProfile @relation(fields: [anchorProfileId], references: [id], onDelete: Cascade)

  @@map("anchor_name_history")
}

model AnchorOperatorAssignment {
  id              String                   @id @default(uuid()) @db.Uuid
  anchorProfileId String                   @map("anchor_profile_id") @db.Uuid
  operatorId      String                   @map("operator_id") @db.Uuid
  status          OperatorAssignmentStatus @default(pending_confirmation)
  startedAt       DateTime?                @map("started_at")
  endedAt         DateTime?                @map("ended_at")
  initiatedBy     String                   @map("initiated_by") @db.VarChar(64)
  confirmedBy     String?                  @map("confirmed_by") @db.VarChar(64)
  reason          String?
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  anchorProfile   AnchorProfile            @relation(fields: [anchorProfileId], references: [id], onDelete: Cascade)
  operator        OperatorAccount          @relation("AssignmentOperator", fields: [operatorId], references: [id])
  submissions     Submission[]

  @@index([anchorProfileId, status])
  @@index([operatorId, status])
